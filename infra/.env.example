# Knowledge Agent 环境变量样例
# 复制为 .env（server/ 和根目录各一份）后填入真实值

# ===== 数据库 =====
# MySQL（业务数据 + 记忆 + trace + 文档关系）
DATABASE_URL="mysql://knowledgeagent:knowledgeagent123@localhost:3306/knowledgeagent"

# PostgreSQL（pgvector 向量库 + LangGraph checkpoint + 全文检索）
PG_URL="postgresql://knowledgeagent:knowledgeagent123@localhost:5432/knowledgeagent"

# ===== Redis（租约锁）=====
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""

# ===== Kafka（KRaft 单节点，文档流水线 + 摘要压缩）=====
KAFKA_BROKERS="localhost:29092"
KAFKA_CLIENT_ID="knowledge-agent"
KAFKA_GROUP_ID_PREFIX="knowledge-agent"

# ===== MinIO（文档存储）=====
MINIO_ENDPOINT="localhost"
MINIO_PORT="9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET="knowledge-agent-docs"
MINIO_USE_SSL="false"

# ===== LLM（阿里云百炼 DashScope，OpenAI 兼容协议）=====
# 申请：https://bailian.console.aliyun.com/ -> 模型广场 -> API-KEY
LLM_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/"
LLM_KEY="sk-填入你的DashScope-API-Key"
LLM_MODEL="qwen-plus"
EMBEDDING_MODEL="text-embedding-v4"
LLM_DISABLE_THINKING="true"   # 关闭部分兼容模型的思考模式（防 reasoning_content 流式解析报错）；OpenAI 官方等不识别该参数的服务设 false

# ===== Rerank（可选，SiliconFlow 兼容协议）=====
RERANK_BASE_URL="https://api.siliconflow.cn/v1"
RERANK_KEY=""
RERANK_MODEL="BAAI/bge-reranker-v2-m3"

# ===== Tavily 联网搜索（可选，ReAct Agent 工具）=====
TAVILY_BASE_URL="https://api.tavily.com"
TAVILY_KEY=""

# ===== 鉴权 =====
JWT_SECRET="knowledge-agent-jwt-secret-change-me-in-production-32chars+"
JWT_EXPIRES_IN="720m"   # 12 小时

# ===== Seed（首个 admin 账号，prisma db seed 读取）=====
# seed.ts 用 upsert，已存在的 admin 不会被覆盖密码
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="admin123"   # 生产环境务必改强密码
# 容器编排总开关：首次部署设 true 触发 server-init 执行 seed，之后设 false（默认）
SEED_ENABLED="false"

# ===== MCP（可选加分项）=====
MCP_ENABLED="false"

# ===== 应用 =====
NODE_ENV="development"
APP_PORT="3000"
# Preview 模式（只读，不接收写操作）
PREVIEW_MODE_ENABLED="false"
PREVIEW_MODE_MESSAGE="预览模式下不可执行写操作"
