# 构建上下文排除项 —— 缩小 build context、防密钥进镜像
# 注意：*.md 排除会误杀 src/modules/chatagent/prompts/*.md（render.ts 运行时读取），
#         用否定模式 ! 白名单保留。

# 依赖与产物（镜像内重新安装/构建，不需要带进去）
node_modules
dist
**/node_modules
**/dist

# 环境变量（含密钥，绝不进镜像）
.env
.env.*
**/.env
**/.env.*

# 测试文件（runner 不需要）
**/*.spec.ts
**/*.test.ts
test
coverage
**/coverage

# 本地工具缓存（非项目文件，不进镜像）
.impeccable
**/.impeccable

# Git / IDE
.git
.gitignore
**/.git
.vscode
.idea

# 文档（镜像不需要）
*.md
**/*.md
# 否定：保留运行时依赖的 prompt 模板（render.ts:12 读取）
!src/modules/chatagent/prompts/*.md

# 系统杂物
.DS_Store
Thumbs.db
*.log
