# 构建上下文排除项 —— 缩小 build context、加速构建

# 依赖与产物（镜像内重新安装/构建）
node_modules
dist
**/node_modules
**/dist

# 环境变量（前端一般无 .env，保险排除）
.env
.env.*
**/.env

# 测试文件（构建不需要）
**/*.spec.ts
**/*.test.ts
src/__tests__
coverage
**/coverage

# 构建缓存
*.tsbuildinfo

# 本地工具缓存（非项目文件，不进镜像）
.impeccable
**/.impeccable

# Git / IDE
.git
.gitignore
**/.git
.vscode
.idea

# 系统杂物
.DS_Store
Thumbs.db
*.log

# 文档（构建不需要）
*.md
**/*.md

# 注意：src/auto-imports.d.ts + src/components.d.ts 虽是 vite 插件自动生成（gitignored），
# 但 vue-tsc -b 在 vite build 前先跑，需要它们做类型检查 → 不排除，随 COPY src 带入。
